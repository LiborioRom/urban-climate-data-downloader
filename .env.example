# Copia este archivo como .env o define las variables en la sesión de VS Code.
# Configuración técnica opcional. Los valores mostrados ya son los predeterminados.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=4096
NOMINATIM_USER_AGENT=lst-prediction-tfm/1.0 (contacto-del-responsable)

# Fuente meteorológica predeterminada. Usa "cds" solo como fallback explícito.
ERA5_SOURCE=earth_engine

# Credenciales obligatorias de los proveedores de datos.
EE_PROJECT=
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Token opcional: solo se usa si falla Earth Engine o ERA5_SOURCE=cds.
CDS_API_KEY=

# Opcional: mueve ejecuciones y caché a un disco con más espacio.
# LST_DATA_ROOT=D:\lst_prediction_data
